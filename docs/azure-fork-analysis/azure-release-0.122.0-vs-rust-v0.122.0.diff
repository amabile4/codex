diff --git a/.github/workflows/build-and-release.yml b/.github/workflows/build-and-release.yml
new file mode 100644
index 0000000000..f41610e73d
--- /dev/null
+++ b/.github/workflows/build-and-release.yml
@@ -0,0 +1,68 @@
+name: build-and-release-windows-azure-fork
+
+on:
+  push:
+    tags:
+      - "azure-release-*"
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build-windows:
+    runs-on: windows-latest
+    timeout-minutes: 240
+    steps:
+      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6
+
+      - uses: dtolnay/rust-toolchain@a0b273b48ed29de4470960879e8381ff45632f26 # 1.93.0
+
+      - uses: actions/cache@668228422ae6a00e4ad889ee87cd7109ec5666a7 # v5
+        with:
+          path: |
+            ~/.cargo/registry
+            ~/.cargo/git
+            codex-rs/target
+          key: windows-${{ hashFiles('**/Cargo.lock') }}
+
+      - name: Build Windows binaries
+        working-directory: codex-rs
+        shell: bash
+        run: |
+          cargo build --release \
+            --bin codex \
+            --bin codex-windows-sandbox-setup \
+            --bin codex-command-runner
+
+      - name: Package zip
+        shell: pwsh
+        run: |
+          # Azure fork: only publish the three Windows executables we support.
+          New-Item -ItemType Directory -Force -Path dist | Out-Null
+          Copy-Item codex-rs/target/release/codex.exe dist/
+          Copy-Item codex-rs/target/release/codex-windows-sandbox-setup.exe dist/
+          Copy-Item codex-rs/target/release/codex-command-runner.exe dist/
+          Compress-Archive dist/* dist/codex-windows.zip -Force
+
+      - uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f # v7
+        with:
+          name: codex-windows
+          path: dist/codex-windows.zip
+
+  release:
+    needs: build-windows
+    if: startsWith(github.ref, 'refs/tags/')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8
+        with:
+          name: codex-windows
+          path: dist
+
+      - uses: softprops/action-gh-release@153bb8e04406b158c6c84fc1615b65b24149a1fe # v2
+        with:
+          tag_name: ${{ github.ref_name }}
+          files: dist/codex-windows.zip
